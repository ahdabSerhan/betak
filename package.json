{
  "name": "betak-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/seo/entry.ts --outDir seo-build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "build:preview": "SITE_BASE=./ vite build",
    "check:a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
